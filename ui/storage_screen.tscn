[gd_scene format=3]

[ext_resource type="Script" path="res://ui/inventory_screen.gd" id="1_screen"]
[ext_resource type="PackedScene" path="res://ui/inventory_slot.tscn" id="2_slot"]
[ext_resource type="PackedScene" path="res://ui/item_menu.tscn" id="3_menu"]
[ext_resource type="Resource" path="res://data/item_actions/send_to_storage.tres" id="4_to_storage"]
[ext_resource type="Resource" path="res://data/item_actions/send_to_inventory.tres" id="5_to_inventory"]
[ext_resource type="Script" path="res://items/actions/item_action.gd" id="6_action"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 4.0
content_margin_top = 4.0
content_margin_right = 4.0
content_margin_bottom = 4.0
bg_color = Color(0.18039216, 0.13333334, 0.18431373, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.38431373, 0.33333334, 0.39607844, 1)

[node name="StorageScreen" type="CanvasLayer"]
script = ExtResource("1_screen")
slot_scene = ExtResource("2_slot")
toggle_action = &""
close_on_cancel = true
container_actions = Array[ExtResource("6_action")]([ExtResource("4_to_storage"), ExtResource("5_to_inventory")])

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = 4.0
offset_right = 4.0
grow_horizontal = 1
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Content" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Content"]
layout_mode = 2
text = "창고"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 140)
layout_mode = 2
horizontal_scroll_mode = 0
scroll_vertical_custom_step = 36.0

[node name="Grid" type="GridContainer" parent="Panel/Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
columns = 5

[node name="InfoLabel" type="Label" parent="Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1
vertical_alignment = 1

[node name="MenuLayer" type="CanvasLayer" parent="."]
layer = 2

[node name="ItemMenu" parent="MenuLayer" instance=ExtResource("3_menu")]
unique_name_in_owner = true
