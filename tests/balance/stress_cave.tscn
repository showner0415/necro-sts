[gd_scene format=3]

[ext_resource type="Script" path="res://regions/region.gd" id="1_region"]
[ext_resource type="Resource" path="res://data/regions/test_corridor.tres" id="2_data"]
[ext_resource type="Resource" path="res://data/regions/base.tres" id="3_base"]
[ext_resource type="Script" path="res://regions/placeholder_walls.gd" id="5_walls"]
[ext_resource type="Script" path="res://regions/navigation_grid.gd" id="6_nav"]
[ext_resource type="PackedScene" path="res://necromancer/necromancer.tscn" id="8_necromancer"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="12_hud"]
[ext_resource type="PackedScene" path="res://ui/inventory_screen.tscn" id="13_inventory"]

[node name="StressCave" type="Node2D"]
script = ExtResource("1_region")
data = ExtResource("2_data")
death_destination = ExtResource("3_base")

[node name="Walls" type="Node2D" parent="."]
script = ExtResource("5_walls")
layout = PackedStringArray("################################################", "#..............................................#", "#..............................................#", "#.####....####....####....####....####....####.#", "#.####....####....####....####....####....####.#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#.####....####....####....####....####....####.#", "#.####....####....####....####....####....####.#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#.####....####....####....####....####....####.#", "#.####....####....####....####....####....####.#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#..............................................#", "#.####....####....####....####....####....####.#", "#.####....####....####....####....####....####.#", "#..............................................#", "#..............................................#", "################################################")

[node name="NavigationGrid" type="Node" parent="."]
script = ExtResource("6_nav")
bounds = Rect2(0, 0, 1536, 1024)
wall_tiles = NodePath("../Walls")

[node name="Actors" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Necromancer" parent="Actors" instance=ExtResource("8_necromancer")]
position = Vector2(240, 240)

[node name="HUD" parent="." instance=ExtResource("12_hud")]

[node name="InventoryScreen" parent="." instance=ExtResource("13_inventory")]
