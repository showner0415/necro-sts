{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash tools/godot.sh *)",
      "Bash(bash tests/check_rules.sh*)",
      "Bash(bash tests/run_all.sh*)",
      "Bash(bash tools/list_scenarios.sh*)",
      "Bash(bash tools/compare_variants.sh *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(python tools/*)",
      "Bash(py tools/*)",
      "mcp__godot__get_godot_version",
      "mcp__godot__get_project_info",
      "mcp__godot__run_project",
      "mcp__godot__stop_project",
      "mcp__godot__get_debug_output",
      "mcp__godot__get_uid",
      "mcp__godot__update_project_uids"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull*)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Edit(./project.godot)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Read(./.godot/**)",
      "Edit(./.godot/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash tools/hooks/session_start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash tools/hooks/stop_check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["godot"]
}
